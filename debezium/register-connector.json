{
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "postgres-source",
    "database.port": "5432",
    "database.user": "sportdata",
    "database.password": "sportdata_pwd",
    "database.dbname": "sportdata_source",
    "topic.prefix": "sportdata",
    "table.include.list": "public.activites_sportives",
    "plugin.name": "pgoutput",
    "publication.autocreate.mode": "filtered",
    "slot.name": "debezium_activites",
    "snapshot.mode": "no_data",
    "decimal.handling.mode": "double",
    "transforms": "unwrap,convertDateDebut,convertDateFin,convertCreatedAt",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.add.fields": "op",
    "transforms.convertDateDebut.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.convertDateDebut.field": "date_debut_activite",
    "transforms.convertDateDebut.target.type": "string",
    "transforms.convertDateDebut.format": "yyyy-MM-dd'T'HH:mm:ss.SSS",
    "transforms.convertDateDebut.unix.precision": "microseconds",
    "transforms.convertDateFin.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.convertDateFin.field": "date_fin_activite",
    "transforms.convertDateFin.target.type": "string",
    "transforms.convertDateFin.format": "yyyy-MM-dd'T'HH:mm:ss.SSS",
    "transforms.convertDateFin.unix.precision": "microseconds",
    "transforms.convertCreatedAt.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.convertCreatedAt.field": "created_at",
    "transforms.convertCreatedAt.target.type": "string",
    "transforms.convertCreatedAt.format": "yyyy-MM-dd'T'HH:mm:ss.SSS",
    "transforms.convertCreatedAt.unix.precision": "microseconds"
}
